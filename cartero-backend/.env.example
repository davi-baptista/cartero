# Local (Docker).
DATABASE_URL="postgresql://cartero:senha123@localhost:5433/cartero"

# Produção (Neon + Render). Os parâmetros abaixo reduzem os avisos
# "Error in PostgreSQL connection: kind: Closed" que aparecem quando o Render
# hiberna ou o Neon suspende o compute e o pool tenta reusar conexões mortas:
#
#   connection_limit=5   O plano free do Render roda uma instância pequena; um
#                        pool grande só multiplica conexões ociosas que o Neon
#                        vai derrubar. Cinco cobre a concorrência real do app.
#   pool_timeout=20      Tempo de espera por uma conexão livre antes de falhar.
#                        Dá margem para o Neon acordar sem estourar a requisição.
#   connect_timeout=15   Cold start do Neon leva alguns segundos; o padrão de 5
#                        expira antes de o banco responder.
#
# Se a URL do Neon contiver "-pooler" (PgBouncer), acrescente também
# pgbouncer=true — sem isso o Prisma prepara statements que o pooler não
# suporta em modo transaction. Nesse caso as migrations precisam de uma
# conexão direta: defina DIRECT_URL com a URL sem "-pooler" e declare
# `directUrl = env("DIRECT_URL")` no datasource do schema.prisma, senão
# `prisma migrate deploy` falha no deploy.
#
# DATABASE_URL="postgresql://USER:PASS@HOST.neon.tech/DB?sslmode=require&connection_limit=5&pool_timeout=20&connect_timeout=15"
JWT_SECRET="secret"
REFRESH_TOKEN_SECRET="secret"
FRONTEND_URL="http://localhost:3001"
CRON_SECRET="secret"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"