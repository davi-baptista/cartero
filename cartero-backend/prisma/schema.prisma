generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                           String    @id @default(uuid())
  email                        String    @unique
  password                     String
  name                         String
  /// Renda aplicável HOJE — cache de leitura, não fonte de verdade.
  ///
  /// A fonte temporal é `SalaryHistory`. Este campo existe porque telas que
  /// não têm mês (perfil, cabeçalhos) precisam de um valor sem resolver
  /// competência, e removê-lo agora exigiria migration destrutiva.
  ///
  /// Sincronizado apenas quando a alteração afeta o mês CORRENTE. Editar um
  /// mês passado ou futuro não o toca — senão uma correção retroativa
  /// mudaria a renda exibida hoje.
  salary                       Decimal?
  createIncomeOnReceivablePaid Boolean   @default(false)
  createExpenseOnDebtPaid      Boolean   @default(false)
  notifyDaysBefore             Int       @default(3)
  /// Timezone financeiro da conta (IANA, ex. "America/Sao_Paulo") — TZ1.
  ///
  /// SEM default de propósito: `null` distingue uma conta legada (criada
  /// antes desta feature, ou que nunca configurou isso explicitamente) de
  /// uma conta que escolheu um fuso. Nenhuma feature financeira lê este
  /// campo ainda — a unificação de "hoje"/competência entre camadas é
  /// trabalho de fases futuras (TZ2+), não desta.
  timeZone                     String
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  banks             Bank[]
  categories        Category[]
  transactions      Transaction[]
  invoices          Invoice[]
  debts             Debt[]
  receivables       Receivable[]
  people            Person[]
  pushSubscriptions PushSubscription[]
  notificationOccurrences NotificationOccurrence[]
  subscriptions     Subscription[]
  recurringIncomeRules RecurringIncomeRule[]
  salaryHistory     SalaryHistory[]
  personSettlementGroups PersonSettlementGroup[]
}

/// Renda mensal recorrente ao longo do tempo.
///
/// Cada linha é uma ALTERAÇÃO que passa a valer a partir de uma competência e
/// segue valendo até a próxima — o usuário não precisa recadastrar o mesmo
/// valor todo mês.
///
/// Antes existia só `User.salary`, o valor atual, usado para calcular qualquer
/// mês: mudar a renda hoje reescrevia retroativamente a sobra e o percentual
/// comprometido de todo o histórico.
///
/// NÃO representa receita real (`Transaction` INCOME). É referência de
/// planejamento; alterar a renda não gera lançamento.
model SalaryHistory {
  id     String @id @default(uuid())
  userId String

  /// Competência inteira, como em `Invoice`: sem ambiguidade de timezone.
  ///
  /// A granularidade é o mês — para o orçamento não importa que a mudança
  /// tenha ocorrido no dia 17. Guardar `DateTime` exigiria normalizar o dia em
  /// toda escrita e comparação, com risco de virada de fuso em cada ponto.
  month Int
  year  Int

  amount Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  /// Uma competência, um valor. O upsert depende deste unique para ser
  /// idempotente: definir "ago/2026 = 5000" duas vezes não cria duplicata.
  @@unique([userId, year, month])
  /// Resolver busca a última entrada `<=` competência pedida.
  @@index([userId, year, month])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  notificationDeliveries NotificationDelivery[]
}

/// Uma ocorrência lógica de notificação por usuário e dia civil.
///
/// A chave natural impede que requests repetidas ou instâncias concorrentes
/// criem dois resumos para a mesma execução lógica. A entrega por device fica
/// em `NotificationDelivery`, porque uma conta pode ter vários subscriptions.
model NotificationOccurrence {
  id        String   @id @default(uuid())
  userId    String
  type      String
  civilDay  String
  deliverySlot String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User                   @relation(fields: [userId], references: [id])
  deliveries NotificationDelivery[]

  @@unique([userId, type, civilDay, deliverySlot])
  @@index([userId, createdAt])
}

enum NotificationDeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

/// Estado durável de uma tentativa por subscription.
///
/// `leaseUntil` permite recuperar uma claim abandonada por crash. Uma queda
/// depois do web-push e antes do ACK pode reenviar uma vez; web-push não
/// oferece exactly-once, portanto a garantia é effectively-once.
model NotificationDelivery {
  id                   String                     @id @default(uuid())
  occurrenceId         String
  pushSubscriptionId   String
  status               NotificationDeliveryStatus @default(PENDING)
  attempts             Int                        @default(0)
  leaseUntil           DateTime?
  lastError            String?
  sentAt               DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  occurrence       NotificationOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  pushSubscription PushSubscription       @relation(fields: [pushSubscriptionId], references: [id], onDelete: Cascade)

  @@unique([occurrenceId, pushSubscriptionId])
  @@index([status, leaseUntil])
}

model Bank {
  id                       String   @id @default(uuid())
  userId                   String
  name                     String
  isSystem                 Boolean  @default(false)
  /// Conta encerrada: não aceita lançamentos novos, mas conserva todo o
  /// histórico — faturas, parcelas futuras e transações seguem existindo e
  /// evoluindo de status. Arquivar não é excluir; é reversível por `restore`.
  isArchived               Boolean  @default(false)
  invoiceCloseDate         Int
  invoiceDueDate           Int
  invoiceDueDaysAfterClose Int      @default(7)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id])
  transactions  Transaction[]
  invoices      Invoice[]
  subscriptions Subscription[]
  invoiceSettlements InvoiceSettlement[]
  personSettlementGroups PersonSettlementGroup[]
}

model Category {
  id        String   @id @default(uuid())
  userId    String
  name      String
  icon      String?
  color     String?
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id])
  transactions  Transaction[]
  subscriptions Subscription[]

  @@unique([userId, name])
}

/// Regra recorrente que gera Transactions — uma assinatura mensal.
model Subscription {
  id               String          @id @default(uuid())
  userId           String
  bankId           String
  categoryId       String
  title            String
  type             TransactionType
  amount           Decimal
  description      String?
  /// Dia do mês da cobrança (1-31). Guarda SEMPRE o valor original: meses
  /// curtos são ajustados na geração, nunca aqui, senão a data andaria para
  /// trás de forma permanente.
  dayOfMonth       Int
  /// Primeiro ciclo coberto, no formato "YYYY-MM". Imutável após a criação.
  ///
  /// Significa "assinando desde" — a origem da assinatura, informação de
  /// produto. NÃO é reaproveitado como marco de geração: sobrescrevê-lo a cada
  /// reativação apagaria esse significado.
  startedAt        String
  /// Primeiro ciclo que a ATIVAÇÃO ATUAL pode gerar, "YYYY-MM".
  ///
  /// Existe porque `isActive + startedAt + lastGeneratedFor` não distinguem
  /// dois casos que exigem tratamento oposto: um mês pendente porque o cron
  /// ficou fora do ar (deve ser gerado) e um mês em que a assinatura estava
  /// pausada (não deve). Sem este marco, reativar após três meses de pausa
  /// gerava as três cobranças de uma vez.
  ///
  /// Nulo significa "sem restrição além de `startedAt`" — o estado de toda
  /// assinatura anterior a esta coluna, e o de qualquer uma que nunca foi
  /// pausada. É gravado ao REATIVAR, nunca ao criar.
  activeSince      String?
  isActive         Boolean         @default(true)
  /// Último ciclo já gerado, "YYYY-MM". Trava de idempotência: sozinho diz
  /// quais ciclos ainda faltam, sem precisar varrer as transações.
  lastGeneratedFor String?
  /// Chave da TENTATIVA de criação, gerada pelo cliente antes do POST.
  ///
  /// Existe porque a criação persiste a assinatura e só depois gera os
  /// lançamentos: uma falha na geração devolvia erro ao cliente com a
  /// assinatura já criada, e o retry natural produzia uma segunda.
  ///
  /// NÃO é chave natural de identidade — o usuário pode legitimamente ter
  /// duas "Netflix", no mesmo banco, com o mesmo valor. É só a impressão
  /// digital de uma tentativa de requisição.
  ///
  /// Nulo nos registros anteriores a este campo e em qualquer criação que não
  /// envie a chave; o índice composto abaixo admite múltiplos nulos.
  creationKey      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now())

  user         User          @relation(fields: [userId], references: [id])
  bank         Bank          @relation(fields: [bankId], references: [id])
  category     Category      @relation(fields: [categoryId], references: [id])
  transactions Transaction[] @relation("SubscriptionLink")

  @@unique([userId, creationKey])
  @@index([userId, isActive])
}

model Transaction {
  id             String          @id @default(uuid())
  parentId       String?
  installmentIndex Int?
  installmentCount Int?
  userId         String
  bankId         String
  categoryId     String
  invoiceId      String?
  personSettlementGroupId String? @unique
  personId       String?
  subscriptionId String?
  title          String
  type           TransactionType
  amount         Decimal
  isRefund       Boolean         @default(false)
  description    String?
  date           DateTime
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now())

  user              User          @relation(fields: [userId], references: [id])
  bank              Bank          @relation(fields: [bankId], references: [id])
  category          Category      @relation(fields: [categoryId], references: [id])
  invoice           Invoice?      @relation(fields: [invoiceId], references: [id])
  personSettlementGroup PersonSettlementGroup? @relation(fields: [personSettlementGroupId], references: [id], onDelete: SetNull)
  person            Person?       @relation(fields: [personId], references: [id])
  subscription      Subscription? @relation("SubscriptionLink", fields: [subscriptionId], references: [id])
  receivable        Receivable?   @relation("ReimbursableLink")
  paymentReceivable Receivable?   @relation("ReceivablePaymentLink")
  paymentDebt       Debt?         @relation("DebtPaymentLink")

  @@index([userId, parentId])
}

enum RecurringIncomeFrequency {
  MONTHLY
}

enum IncomeClassification {
  INCOME
  OTHER
}

/// Configuração de uma renda esperada recorrente.
///
/// A regra só descreve ocorrências futuras. Cada Receivable materializado é
/// um snapshot financeiro independente e não é sincronizado depois.
model RecurringIncomeRule {
  id              String                  @id @default(uuid())
  userId          String
  title           String
  amount          Decimal
  frequency       RecurringIncomeFrequency @default(MONTHLY)
  dayOfMonth      Int
  firstOccurrence String
  counterpartyName String?
  isActive        Boolean                 @default(true)
  deletedAt       DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  receivables Receivable[]

  @@index([userId, isActive])
  @@index([userId, deletedAt])
}

model Invoice {
  id          String        @id @default(uuid())
  userId      String
  bankId      String
  month       Int
  year        Int
  status      InvoiceStatus
  totalAmount Decimal       @default(0)
  /// Dia do fechamento desta fatura, congelado na criação.
  ///
  /// Antes era derivado da configuração ATUAL do banco a cada leitura, então
  /// mudar o vencimento do cartão reescrevia as datas de todo o histórico —
  /// uma fatura paga em agosto passava a exibir outro vencimento. Persistir
  /// torna a data um fato da fatura, não uma função do banco.
  ///
  /// `DateTime` e não `@db.Date`: nenhum campo date-only do schema usa `Date`,
  /// e `Receivable.dueDate` — que recebe cópias deste valor — é `DateTime`.
  /// Tipos diferentes forçariam conversão implícita entre campos comparados
  /// entre si. A âncora de 3h UTC é a mesma que `dateForDayUtc` já aplicava.
  closeDate   DateTime
  /// Vencimento desta fatura, congelado na criação. Ver `closeDate`.
  dueDate     DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now())

  user         User          @relation(fields: [userId], references: [id])
  bank         Bank          @relation(fields: [bankId], references: [id])
  transactions Transaction[]
  settlement   InvoiceSettlement?
}

model InvoiceSettlement {
  id        String   @id @default(uuid())
  invoiceId String   @unique
  amount    Decimal
  paidAt    DateTime
  bankId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  bank    Bank    @relation(fields: [bankId], references: [id])

  @@index([bankId, paidAt])
}

model Debt {
  id                   String    @id @default(uuid())
  userId               String
  personId             String?
  parentId             String?
  paymentTransactionId String?   @unique
  title                String
  creditorName         String
  amount               Decimal
  description          String?
  occurredAt           DateTime
  dueDate              DateTime
  isAlertEnabled       Boolean   @default(true)
  isPaid               Boolean   @default(false)
  paidAt               DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now())

  user               User         @relation(fields: [userId], references: [id])
  person             Person?      @relation(fields: [personId], references: [id])
  paymentTransaction Transaction? @relation("DebtPaymentLink", fields: [paymentTransactionId], references: [id])
  settlementMembership PersonSettlementDebt[]
}

model Receivable {
  id                   String    @id @default(uuid())
  userId               String
  personId             String?
  parentId             String?
  transactionId        String?   @unique
  paymentTransactionId String?   @unique
  recurringIncomeRuleId String?
  recurringMonth       String?
  incomeClassification IncomeClassification?
  title                String
  debtorName           String
  amount               Decimal
  description          String?
  occurredAt           DateTime
  dueDate              DateTime
  isPaid               Boolean   @default(false)
  paidAt               DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now())

  user               User         @relation(fields: [userId], references: [id])
  person             Person?      @relation(fields: [personId], references: [id])
  transaction        Transaction? @relation("ReimbursableLink", fields: [transactionId], references: [id])
  paymentTransaction Transaction? @relation("ReceivablePaymentLink", fields: [paymentTransactionId], references: [id])
  recurringIncomeRule RecurringIncomeRule? @relation(fields: [recurringIncomeRuleId], references: [id])
  settlementMembership PersonSettlementReceivable[]

  @@unique([recurringIncomeRuleId, recurringMonth])
  @@index([userId, recurringMonth])
}

model Person {
  id        String   @id @default(uuid())
  userId    String
  name      String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id])
  debts        Debt[]
  receivables  Receivable[]
  transactions Transaction[]
  settlementGroups PersonSettlementGroup[]
}

enum PersonSettlementDirection {
  INFLOW
  OUTFLOW
  NONE
}

enum PersonSettlementStatus {
  ACTIVE
  REVERSED
}

/// Structural authority for a net settlement between a user and a person.
/// It is deliberately not a Transaction: a group settlement has no payment
/// method and must not manufacture per-item cash movements.
model PersonSettlementGroup {
  id        String                  @id @default(uuid())
  userId    String
  personId  String
  settledAt DateTime
  direction PersonSettlementDirection
  netAmount Decimal
  bankId    String?
  paymentType TransactionType?
  status    PersonSettlementStatus   @default(ACTIVE)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  user       User    @relation(fields: [userId], references: [id])
  person     Person  @relation(fields: [personId], references: [id])
  bank       Bank?   @relation(fields: [bankId], references: [id])
  debts      PersonSettlementDebt[]
  receivables PersonSettlementReceivable[]
  creditTransaction Transaction?

  @@index([userId, personId, status])
  @@index([bankId])
}

model PersonSettlementDebt {
  groupId    String
  debtId     String
  amount     Decimal
  createdAt  DateTime @default(now())

  group PersonSettlementGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  debt  Debt                  @relation(fields: [debtId], references: [id])

  @@id([groupId, debtId])
  @@index([groupId])
}

model PersonSettlementReceivable {
  groupId      String
  receivableId String
  amount       Decimal
  createdAt    DateTime @default(now())

  group      PersonSettlementGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  receivable Receivable             @relation(fields: [receivableId], references: [id])

  @@id([groupId, receivableId])
  @@index([groupId])
}

enum TransactionType {
  INCOME
  CREDIT_CARD
  DEBIT_CARD
  PIX
  BOLETO
}

enum InvoiceStatus {
  OPEN
  CLOSED
  PAID
  OVERDUE
}
