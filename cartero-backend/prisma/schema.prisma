generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                           String   @id @default(uuid())
  email                        String   @unique
  password                     String
  name                         String
  salary                       Decimal?
  createIncomeOnReceivablePaid Boolean  @default(true)
  createExpenseOnDebtPaid      Boolean  @default(true)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  banks        Bank[]
  categories   Category[]
  transactions Transaction[]
  invoices     Invoice[]
  debts        Debt[]
  receivables  Receivable[]
  people       Person[]
}

model Bank {
  id                       String   @id @default(uuid())
  userId                   String
  name                     String
  isSystem                 Boolean  @default(false)
  invoiceCloseDate         Int
  invoiceDueDate           Int
  invoiceDueDaysAfterClose Int      @default(7)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]
  invoices     Invoice[]
}

model Category {
  id        String   @id @default(uuid())
  userId    String
  name      String
  icon      String?
  color     String?
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]

  @@unique([userId, name])
}

model Transaction {
  id          String          @id @default(uuid())
  parentId    String?
  userId      String
  bankId      String
  categoryId  String
  invoiceId   String?
  personId    String?
  title       String
  type        TransactionType
  amount      Decimal
  isRefund    Boolean         @default(false)
  description String?
  date        DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now())

  user              User        @relation(fields: [userId], references: [id])
  bank              Bank        @relation(fields: [bankId], references: [id])
  category          Category    @relation(fields: [categoryId], references: [id])
  invoice           Invoice?    @relation(fields: [invoiceId], references: [id])
  person            Person?     @relation(fields: [personId], references: [id])
  receivable        Receivable? @relation("ReimbursableLink")
  paymentReceivable Receivable? @relation("ReceivablePaymentLink")
  paymentDebt       Debt?       @relation("DebtPaymentLink")
}

model Invoice {
  id          String        @id @default(uuid())
  userId      String
  bankId      String
  month       Int
  year        Int
  status      InvoiceStatus
  totalAmount Decimal       @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now())

  user         User          @relation(fields: [userId], references: [id])
  bank         Bank          @relation(fields: [bankId], references: [id])
  transactions Transaction[]
}

model Debt {
  id                   String    @id @default(uuid())
  userId               String
  personId             String?
  parentId             String?
  paymentTransactionId String?   @unique
  title                String
  creditorName         String
  amount               Decimal
  description          String?
  occurredAt           DateTime
  dueDate              DateTime
  isAlertEnabled       Boolean   @default(true)
  isPaid               Boolean   @default(false)
  paidAt               DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now())

  user               User         @relation(fields: [userId], references: [id])
  person             Person?      @relation(fields: [personId], references: [id])
  paymentTransaction Transaction? @relation("DebtPaymentLink", fields: [paymentTransactionId], references: [id])
}

model Receivable {
  id                   String    @id @default(uuid())
  userId               String
  personId             String?
  parentId             String?
  transactionId        String?   @unique
  paymentTransactionId String?   @unique
  title                String
  debtorName           String
  amount               Decimal
  description          String?
  occurredAt           DateTime
  dueDate              DateTime
  isPaid               Boolean   @default(false)
  paidAt               DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now())

  user               User         @relation(fields: [userId], references: [id])
  person             Person?      @relation(fields: [personId], references: [id])
  transaction        Transaction? @relation("ReimbursableLink", fields: [transactionId], references: [id])
  paymentTransaction Transaction? @relation("ReceivablePaymentLink", fields: [paymentTransactionId], references: [id])
}

model Person {
  id        String   @id @default(uuid())
  userId    String
  name      String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id])
  debts        Debt[]
  receivables  Receivable[]
  transactions Transaction[]
}

enum TransactionType {
  INCOME
  CREDIT_CARD
  DEBIT_CARD
  PIX
  BOLETO
}

enum InvoiceStatus {
  OPEN
  CLOSED
  PAID
  OVERDUE
}
