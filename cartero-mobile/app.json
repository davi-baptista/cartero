{
  "expo": {
    "name": "Cartero",
    "slug": "cartero-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "cartero",
    "ios": {
      "bundleIdentifier": "app.cartero.mobile.dev",
      "supportsTablet": false
    },
    "android": {
      "package": "app.cartero.mobile.dev"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "carteroApiUrl": "http://10.0.2.2:3000"
    }
  }
}
